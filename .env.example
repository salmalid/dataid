# Copy to .env and fill in. Every provider below is free to start; huggingface is the one
# that meters past a small included credit.
# dataid works with none of them. Without a provider the pipeline still computes every metric,
# ranking and attribution — it just reports them without written commentary.

# none | ollama | groq | openrouter | gemini | nvidia | huggingface
DATAID_LLM_PROVIDER=none

# nvidia build — free credits, no billing account: https://build.nvidia.com
NVIDIA_API_KEY=
DATAID_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# auto | on | off — the nemotron-3 family requires thinking; models served without a
# reasoning config return HTTP 500 if it is sent, so leave this on auto unless you know better.
DATAID_NVIDIA_THINKING=auto
DATAID_NVIDIA_REASONING_BUDGET=8192

# huggingface — Inference Providers router, one token for every served open-weights model:
# https://huggingface.co/settings/tokens (needs the "Make calls to Inference Providers" scope)
# Metered per token beyond a small monthly credit; PRO raises the included amount.
HF_TOKEN=
DATAID_HF_MODEL=moonshotai/Kimi-K3
# Kimi K3 reasons on every call with no way to disable it, and thinking shares the completion
# budget with the prose. Thinking models get this budget instead of LLM_MIN_MAX_TOKENS; at the
# 2048 floor the longer narration prompts come back truncated.
DATAID_HF_REASONING_BUDGET=8192

# gemini — free tier, no billing account: https://aistudio.google.com/apikey
GEMINI_API_KEY=
DATAID_GEMINI_MODEL=gemini-2.5-flash

# groq — free tier: https://console.groq.com/keys
GROQ_API_KEY=
DATAID_GROQ_MODEL=llama-3.3-70b-versatile

# openrouter — free-tier models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
DATAID_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ollama — free and local, no key: `ollama serve && ollama pull llama3.1`
OLLAMA_HOST=http://localhost:11434
DATAID_OLLAMA_MODEL=llama3.1

# Raise if a thinking model returns truncated prose (finish_reason="length").
DATAID_LLM_MIN_MAX_TOKENS=2048
DATAID_LLM_RETRIES=2
# Optional access control for the shared workspace. Keep the default for local use.
DATAID_REQUIRE_API_KEY=false
DATAID_ADMIN_TOKEN=
